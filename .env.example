# ===== مزوّد الذكاء الاصطناعي =====
# يمكن اختيار المزوّد من صفحة الإعدادات داخل التطبيق أيضاً.
# local  = نموذج محلي (Ollama / LM Studio / vLLM) عبر واجهة متوافقة مع OpenAI
# claude = Claude من Anthropic
AI_PROVIDER=local

# النموذج المحلي
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=qwen2.5:7b
# LOCAL_AI_API_KEY=   # اختياري إذا كان الخادم المحلي يطلب مفتاح

# Claude (مطلوب فقط إذا اخترت claude)
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# ===== Meta Webhook (اختياري، لاستقبال رسائل واتساب/فيسبوك/إنستغرام تلقائياً) =====
# META_VERIFY_TOKEN=any-secret-string-you-choose
# META_APP_SECRET=

# مسار ملف البيانات (اختياري)
# DATA_DIR=./data

# ===== حماية بكلمة سر (مهم إذا فتحت التطبيق على الإنترنت) =====
# APP_USER=admin
# APP_PASSWORD=
